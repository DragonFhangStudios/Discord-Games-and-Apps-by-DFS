<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Discord_Games_and_Apps_by_DFS</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- This project sits at the repo root, so keep it from compiling the other projects' sources. -->
  <ItemGroup>
    <Compile Remove="src\**;Tests\**;Bots\**" />
    <None Remove="src\**;Tests\**;Bots\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tests\" />
    <Folder Include="RaspberryPi\" />
    <Folder Include="Data\" />
    <Folder Include="Views\" />
  </ItemGroup>

</Project>
